{
  "name": "claude-gh-guard",
  "version": "0.2.0",
  "description": "Stop Claude Code from committing to your work repo with your personal GitHub account",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seuthootDev/claude-gh-guard.git"
  },
  "homepage": "https://github.com/seuthootDev/claude-gh-guard#readme",
  "bugs": {
    "url": "https://github.com/seuthootDev/claude-gh-guard/issues"
  },
  "type": "module",
  "bin": {
    "claude-gh-guard": "dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "claude-code",
    "github",
    "gh",
    "git",
    "guard",
    "hook",
    "statusline"
  ]
}
